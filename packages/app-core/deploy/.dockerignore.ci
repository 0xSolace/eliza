# Workspace-native cloud image context.
# Dockerfile.ci copies the full milady + eliza workspace and runs `bun install`
# inside the image, so never send host node_modules or selective vendored slices.

.git
.git/**
**/.git
**/.git/**
.github
.claude
.devin
.vscode
.idea
.env
.env.local
.env.*.local

node_modules
**/node_modules
**/.turbo
**/.cache
**/.eliza
**/.elizadb
**/.elizadb-test

coverage
dev.log
.docker-home
.tmp
artifacts

apps/app/android
apps/app/ios
apps/app/electrobun
apps/app/.vite
apps/app/screenshots
apps/app/test-results
apps/app/test
docs/
packaging/

# Keep deploy/Dockerfile.ci reachable, but runtime config docs are not needed in context.
deploy/nyx
